<Project Sdk="Atya.Build.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Atya.Foundation.Primitives</PackageId>
    <AssemblyName>Atya.Foundation.Primitives</AssemblyName>
    <RootNamespace>Atya.Foundation.Primitives</RootNamespace>
    <IsPackable>true</IsPackable>
    <Authors>Arsen Asulyan</Authors>
    <Copyright>Copyright (c) 2026 Arsen Asulyan</Copyright>
    <Description>Primitive types and value objects for Atya foundation packages.</Description>
    <PackageTags>dotnet;foundation;primitives;atya</PackageTags>
    <RepositoryUrl>https://github.com/AtyaLibraries/Primitives</RepositoryUrl>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <NoWarn>$(NoWarn);CA1716;CA1000;SA1600</NoWarn>

    <!-- MinVer derives the version from git tags (e.g. tag `v1.2.3` -> 1.2.3). -->
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup Label="Runtime dependencies">
    <PackageReference Include="Atya.Foundation.Abstractions" />
    <PackageReference Include="Atya.Foundation.Guards" />
  </ItemGroup>

</Project>
